# Kapate OS - Backend Environment Configuration
PROJECT_NAME="Kapate OS"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Tokens
SECRET_KEY="kapate-os-dev-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQL:
# Production PostgreSQL: postgresql://postgres:postgres@localhost:5432/kapate_os
# Development SQLite: sqlite:///./kapate_os.db
DATABASE_URL="sqlite:///./kapate_os.db"

# MongoDB Document Database:
# Local Docker / Community: mongodb://localhost:27017
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="kapate_os"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Superadmin Seed Defaults
FIRST_SUPERADMIN_EMAIL="admin@kapateconsultancy.com"
FIRST_SUPERADMIN_PASSWORD="KapateOS@2026!"
FIRST_SUPERADMIN_NAME="Kapate Master Admin"

# Real-Time SMTP Email Dispatch Configuration
# Gmail Example:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-16-char-app-password"
# SMTP_TLS=True
# SMTP_SSL=False
# EMAILS_FROM_EMAIL="your-email@gmail.com"
# EMAILS_FROM_NAME="Kapate OS Security"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
SMTP_TIMEOUT=10
EMAILS_FROM_EMAIL="security@kapateconsultancy.com"
EMAILS_FROM_NAME="Kapate OS Security"
ALLOW_SELF_REGISTRATION_OTP=True
DEFAULT_OTP_USER_ROLE="consultant"

