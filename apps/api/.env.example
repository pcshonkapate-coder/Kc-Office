PROJECT_NAME="Kapate OS Enterprise API"
VERSION="3.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

SECRET_KEY="replace-with-a-very-strong-production-secret-key-32-chars-min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://os.kapateconsultancy.com"

# PostgreSQL (Asyncpg) or SQLite (for local dev fallback)
DATABASE_URL="postgresql+asyncpg://kapate_admin:secure_password@localhost:5432/kapate_os_v3"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis Connection
REDIS_URL="redis://localhost:6379/0"
