# ==============================================================================
# KAPATE OS 3.0 - ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice: Copy this file to '.env' and populate with secret values.
# NEVER commit the active '.env' file containing real secrets to version control.

# --- SYSTEM & ENVIRONMENT ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="KAPATE OS 3.0"
VERSION="3.0.0"

# --- APPLICATION HOSTING & CORS ---
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.kapateconsultancy.in/api/v1
BACKEND_CORS_ORIGINS=["https://os.kapateconsultancy.in","https://kapateconsultancy.in","http://localhost:3000"]

# --- CRYPTOGRAPHIC KEYS & JWT ---
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_minimum_48_character_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- POSTGRESQL PRIMARY DATABASE ---
POSTGRES_USER=kapate_admin
POSTGRES_PASSWORD=replace_with_strong_database_password_2026
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kapate_os_v3
DATABASE_URL=postgresql+asyncpg://kapate_admin:replace_with_strong_database_password_2026@postgres:5432/kapate_os_v3

# --- REDIS (SESSIONS, TOKEN BLACKLIST, CHAT WS PUBSUB) ---
REDIS_PASSWORD=replace_with_strong_redis_password_2026
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://:replace_with_strong_redis_password_2026@redis:6379/0

# --- AI COPILOT & LLM ORCHESTRATION ---
AI_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-production-openai-api-key
GEMINI_API_KEY=your-production-gemini-api-key
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# --- ENTERPRISE OBJECT STORAGE (S3 / MINIO) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/app/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=kapate-os-documents-vault

# --- EMAIL / SMTP NOTIFICATIONS ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_production_sendgrid_token
SMTP_TLS=true
EMAILS_FROM_EMAIL=notifications@kapateconsultancy.in
EMAILS_FROM_NAME="KAPATE OS Enterprise Systems"
